# Server Port
PORT=3000
HOST=0.0.0.0

# GitHub Configuration
GITHUB_OWNER=Dicecan
GITHUB_REPO=ChunkoidNG
# Optional GitHub Personal Access Token (PAT) for 5000 req/hr rate limits instead of 60 req/hr
GITHUB_TOKEN=
# Webhook secret configured on GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=

# Auto Sync Interval (in minutes)
SYNC_INTERVAL_MINUTES=30
# Whether to automatically download new release APKs to local storage
AUTO_DOWNLOAD_APK=true
# Max number of historical APKs to keep on local disk
MAX_DOWNLOAD_HISTORY_COUNT=5

# Admin API token for updating mirrors or triggering manual sync via HTTP
ADMIN_TOKEN=chunkoid-admin-change-me
